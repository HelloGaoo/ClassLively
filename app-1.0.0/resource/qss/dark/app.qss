/* 启动窗口 深色 */
#contentWidget {
    background-color: rgba(32, 32, 32, 0.78);
    border-radius: 10px;
}

/* 标签 */
StrongBodyLabel {
    color: #FFFFFF;
    font-size: 24px;
    font-weight: bold;
}

BodyLabel {
    color: #999999;
    font-size: 14px;
}

#versionLabel {
    color: #777777;
    font-size: 12px;
}

#statusLabel {
    color: #CCCCCC;
    font-size: 13px;
}

/* 进度条 */
ProgressBar {
    background-color: #3A3A3A;
    border-radius: 2px;
    min-height: 4px;
    max-height: 4px;
}

ProgressBar::chunk {
    background-color: #0078D4;
    border-radius: 2px;
}

/* 向导窗口 */
WizardWindow {
    background-color: #272727;
}

WizardWindow QWidget {
    background-color: #272727;
}

WizardWindow StrongBodyLabel {
    color: #FFFFFF;
    font-size: 28px;
    font-weight: 900;
    margin-top: 8px;
    margin-bottom: 8px;
}

WizardWindow BodyLabel {
    color: rgba(255, 255, 255, 0.8);
    font-size: 20px;
    margin-top: 6px;
    margin-bottom: 6px;
}

WizardWindow QLabel#titleLabel {
    color: #FFFFFF;
    font-size: 16px;
    font-weight: bold;
}

WizardWindow QLabel#welcomeLabel {
    margin: 0;
    padding-left: 8px;
}

WizardWindow CheckBox {
    color: #FFFFFF;
    font-size: 18px;
    margin-top: 4px;
    margin-bottom: 4px;
}

WizardWindow PushButton#closeButton {
    background-color: transparent;
    border: none;
    color: #FFFFFF;
    font-size: 20px;
    border-radius: 15px;
}

WizardWindow PushButton#closeButton:hover {
    background-color: #E81123;
    color: #FFFFFF;
}

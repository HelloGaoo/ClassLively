/* 下载界面 浅色 */

#download {
    background: transparent;
    border: none;
}

#download QScrollArea {
    background: transparent;
    border: none;
}

/* 标题 */

#download QLabel#settingLabel {
    font-size: 33px;
    background-color: transparent;
    color: #000000;
}

/* 卡片 */

#download CardWidget {
    background-color: rgba(255, 255, 255, 0.8);
    border: 1px solid rgba(0, 0, 0, 0.06);
    border-radius: 8px;
}

#download CardWidget:hover {
    background-color: rgba(255, 255, 255, 1.0);
}

/* 标签 */

#download QLabel#softwareNameLabel {
    font-size: 18px;
    color: #000000;
}

#download QLabel#softwareDescLabel {
    font-size: 14px;
    color: #666666;
}

#download QLabel#sectionTitleLabel {
    font-size: 20px;
    color: #000000;
    margin-top: 20px;
    margin-bottom: 10px;
}

#download QLabel#modeLabel,
#download QLabel#sourceLabel {
    font-size: 18px;
    color: #333333;
}

#download QLabel#softwareEmptyIconLabel {
    font-size: 32px;
    background-color: transparent;
}

/* 模式选择 */

#download #modeContainer {
    margin-top: 8px;
    margin-bottom: 8px;
}

#download QRadioButton {
    font-size: 14px;
    color: #333333;
}

#download QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border-radius: 8px;
    border: 2px solid #999999;
    background-color: transparent;
}

#download QRadioButton::indicator:checked {
    border: 2px solid #ff6b9d;
    background-color: #ff6b9d;
}

#download QRadioButton::indicator:hover {
    border: 2px solid #ff8fb3;
}

/* 下载源下拉框 */

#download ComboBox#sourceComboBox {
    font-size: 14px;
    color: #333333;
    background-color: rgba(255, 255, 255, 0.8);
    border: 1px solid rgba(0, 0, 0, 0.06);
    border-radius: 6px;
    padding: 4px 8px;
}

#download ComboBox#sourceComboBox:hover {
    background-color: rgba(255, 255, 255, 1.0);
    border: 1px solid rgba(0, 0, 0, 0.15);
}

#download ComboBox#sourceComboBox::drop-down {
    border: none;
    width: 30px;
}

#download ComboBox#sourceComboBox::down-arrow {
    image: none;
    border: none;
    width: 12px;
    height: 12px;
    margin-right: 8px;
}

/* 按钮 */

#download PushButton#startButton {
    font-size: 14px;
    color: #ffffff;
    background-color: #00c853;
    border: none;
    border-radius: 6px;
    padding: 6px 16px;
}

#download PushButton#startButton:hover {
    background-color: #00e676;
}

#download PushButton#startButton:pressed {
    background-color: #009624;
}

#download QToolButton#softwareLinkButton {
    border: none;
    background: transparent;
    border-radius: 4px;
}

#download QToolButton#softwareLinkButton:hover {
    background: rgba(0, 0, 0, 0.05);
}

/* 进度环 */

#download ProgressRing {
    background-color: transparent;
}

#download ProgressRing::chunk {
    background-color: #00c853;
    border-radius: 30px;
}

/* 分页栏 */

#download #paginationBar {
    background-color: transparent;
    padding: 8px 0px;
}

#download #paginationBar PushButton {
    font-size: 14px;
    color: #333333;
    background-color: rgba(255, 255, 255, 0.6);
    border: 1px solid rgba(0, 0, 0, 0.06);
    border-radius: 6px;
    margin: 0px 4px;
}

#download #paginationBar PushButton:hover {
    background-color: rgba(255, 255, 255, 1.0);
    border: 1px solid rgba(0, 0, 0, 0.15);
}

#download #paginationBar PushButton[paginationActive="true"] {
    color: #ffffff;
    background-color: #ff6b9d;
    border: 1px solid #ff6b9d;
}

#download #paginationBar PushButton[paginationActive="true"]:hover {
    background-color: #ff8fb3;
    border: 1px solid #ff8fb3;
}

/* 调试面板 浅色 */
#debug {
    background: transparent;
    border: none;
}

#debug QScrollArea {
    background-color: transparent;
    border: none;
}

/* 标题 */
#debug QLabel#settingLabel {
    font-size: 33px;
    background-color: transparent;
    color: #000000;
}

#debug SubtitleLabel {
    color: #000000;
    font-size: 18px;
    font-weight: 600;
}

#debug BodyLabel {
    color: #333333;
    font-size: 14px;
}

#debug StrongBodyLabel {
    color: #000000;
    font-size: 14px;
    font-weight: 600;
}

#debug BodyLabel#debugValueLabel {
    font-size: 18px;
    font-weight: bold;
    color: #0078d4;
}

#debug QLabel {
    color: #333333;
    background-color: transparent;
}

#debug QLabel#debugSeparator {
    background-color: #d0d0d0;
    max-height: 1px;
}

/* 卡片 */
#debug CardWidget {
    background-color: #ffffff;
    border: 1px solid #d0d0d0;
    border-radius: 8px;
}

#debug CardWidget:hover {
    border: 1px solid #0078d4;
}

/* 按钮 */
#debug PrimaryPushButton {
    background-color: #0078d4;
    color: #ffffff;
    border: none;
    border-radius: 4px;
    padding: 6px 16px;
    font-weight: 600;
    font-size: 14px;
}

#debug PrimaryPushButton:hover {
    background-color: #1084d8;
}

#debug PrimaryPushButton:pressed {
    background-color: #006cbe;
}

#debug PushButton {
    background-color: #e0e0e0;
    color: #000000;
    border: 1px solid #cccccc;
    border-radius: 4px;
    padding: 6px 16px;
    font-size: 14px;
}

#debug PushButton:hover {
    background-color: #f0f0f0;
    border-color: #999999;
}

#debug PushButton:pressed {
    background-color: #d0d0d0;
}

#debug ToggleButton {
    background-color: transparent;
    color: #000000;
    border: 1px solid #cccccc;
    border-radius: 4px;
    padding: 6px 16px;
    font-size: 14px;
}

#debug ToggleButton:hover {
    background-color: rgba(0, 0, 0, 0.05);
}

#debug ToggleButton:checked {
    background-color: #0078d4;
    border-color: #0078d4;
    color: #ffffff;
}

/* 输入控件 */
#debug QTextEdit {
    background-color: #f9f9f9;
    color: #333333;
    border: 1px solid #d0d0d0;
    border-radius: 4px;
    padding: 8px;
    font-size: 13px;
    selection-background-color: #0078d4;
}

#debug QTextEdit:focus {
    border: 1px solid #0078d4;
}

#debug QTextEdit:disabled {
    background-color: #f0f0f0;
    color: #888888;
}

#debug SpinBox {
    background-color: #ffffff;
    color: #000000;
    border: 1px solid #cccccc;
    border-radius: 4px;
    padding: 4px 8px;
}

#debug SpinBox:hover {
    border-color: #0078d4;
}

#debug SpinBox::up-button,
#debug SpinBox::down-button {
    border: none;
    width: 16px;
    background-color: transparent;
}

#debug SpinBox::up-button:hover,
#debug SpinBox::down-button:hover {
    background-color: #e0e0e0;
}

#debug ComboBox {
    background-color: #ffffff;
    color: #000000;
    border: 1px solid #cccccc;
    border-radius: 4px;
    padding: 6px 12px;
    min-width: 120px;
}

#debug ComboBox:hover {
    border-color: #0078d4;
}

#debug ComboBox::drop-down {
    border: none;
    width: 24px;
}

#debug ComboBox::down-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 5px solid #000000;
    margin-right: 8px;
}

#debug QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #000000;
    border: 1px solid #d0d0d0;
    selection-background-color: #0078d4;
    outline: none;
}

#debug QComboBox QAbstractItemView::item {
    height: 32px;
    padding-left: 12px;
}

#debug QComboBox QAbstractItemView::item:hover {
    background-color: #e0e0e0;
}

#debug QComboBox QAbstractItemView::item:selected {
    background-color: #0078d4;
}

/* 复选框 */
#debug QCheckBox {
    color: #000000;
    spacing: 8px;
}

#debug QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border-radius: 4px;
    border: 1px solid #cccccc;
    background-color: #ffffff;
}

#debug QCheckBox::indicator:checked {
    background-color: #0078d4;
    border-color: #0078d4;
}

/* 进度条 */
#debug QProgressBar {
    background-color: #e0e0e0;
    border: none;
    border-radius: 4px;
    text-align: center;
    color: #000000;
    height: 8px;
}

#debug QProgressBar::chunk {
    background-color: #0078d4;
    border-radius: 4px;
}

/* 分组框 */
#debug QGroupBox {
    background-color: #ffffff;
    border: 1px solid #d0d0d0;
    border-radius: 8px;
    margin-top: 12px;
    padding-top: 12px;
    font-weight: 600;
    color: #000000;
}

#debug QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0 8px;
    color: #0078d4;
}

/* 滚动条 */
#debug QScrollBar:vertical {
    background-color: #f3f3f3;
    width: 10px;
    border-radius: 5px;
    margin: 2px;
}

#debug QScrollBar::handle:vertical {
    background-color: #cccccc;
    border-radius: 5px;
    min-height: 20px;
    margin: 2px;
}

#debug QScrollBar::handle:vertical:hover {
    background-color: #bbbbbb;
}

#debug QScrollBar::handle:vertical:pressed {
    background-color: #aaaaaa;
}

#debug QScrollBar::add-line:vertical,
#debug QScrollBar::sub-line:vertical {
    height: 0px;
}

#debug QScrollBar::add-page:vertical,
#debug QScrollBar::sub-page:vertical {
    background: none;
}

/* 天气图标网格 */
#debug #weatherIconGrid {
    background-color: transparent;
}

#debug #weatherIconGrid CardWidget {
    background-color: rgba(0, 0, 0, 0.03);
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 8px;
}

#debug #weatherIconGrid CardWidget:hover {
    background-color: rgba(0, 120, 212, 0.08);
    border: 1px solid rgba(0, 120, 212, 0.3);
}

#debug #weatherIconGrid CardWidget BodyLabel {
    color: #555555;
}

#debug BodyLabel#weatherCodeLabel {
    font-size: 11px;
    font-weight: bold;
}

#debug BodyLabel#weatherNameLabel {
    font-size: 10px;
}

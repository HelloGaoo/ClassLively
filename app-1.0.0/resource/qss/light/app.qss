/* 启动窗口 浅色 */
#contentWidget {
    background-color: rgba(255, 255, 255, 0.78);
    border-radius: 10px;
}

/* 标签 */
StrongBodyLabel {
    color: #000000;
    font-size: 24px;
    font-weight: bold;
}

BodyLabel {
    color: #888888;
    font-size: 14px;
}

#versionLabel {
    color: #AAAAAA;
    font-size: 12px;
}

#statusLabel {
    color: #333333;
    font-size: 13px;
}

/* 进度条 */
ProgressBar {
    background-color: #E0E0E0;
    border-radius: 2px;
    min-height: 4px;
    max-height: 4px;
}

ProgressBar::chunk {
    background-color: #0078D4;
    border-radius: 2px;
}

/* 向导窗口 */
WizardWindow {
    background-color: #F7F7F7;
}

WizardWindow QWidget {
    background-color: #F7F7F7;
}

WizardWindow StrongBodyLabel {
    color: #000000;
    font-size: 28px;
    font-weight: 900;
    margin-top: 8px;
    margin-bottom: 8px;
}

WizardWindow BodyLabel {
    color: rgba(0, 0, 0, 0.8);
    font-size: 20px;
    margin-top: 6px;
    margin-bottom: 6px;
}

WizardWindow QLabel#titleLabel {
    color: #000000;
    font-size: 16px;
    font-weight: bold;
}

WizardWindow QLabel#welcomeLabel {
    margin: 0;
    padding-left: 8px;
}

WizardWindow CheckBox {
    color: #000000;
    font-size: 18px;
    margin-top: 4px;
    margin-bottom: 4px;
}

WizardWindow PushButton#closeButton {
    background-color: transparent;
    border: none;
    color: #000000;
    font-size: 20px;
    border-radius: 15px;
}

WizardWindow PushButton#closeButton:hover {
    background-color: #E81123;
    color: #FFFFFF;
}

/* 主页界面 浅色 */
#homeBackgroundImage,
#editContainer,
#mediaContainer,
#quickLaunchContainer,
#quickLaunchDock,
#pagesContainer,
#pagesStack {
    background-color: transparent;
}

#pagesContainer {
    border: none;
}

/* 组件卡片 */
#clockContainer,
#calendarContainer,
#weatherContainer,
#schoolInfoContainer,
#poetryContainer,
#countdownContainer,
#nowLessonContainer,
#calculatorDisplayColor {
    background-color: rgba(255, 255, 255, 0.55);
    border-radius: 16px;
    border: 1px solid rgba(0, 0, 0, 0.06);
}

/* 悬停提示 */
#qlTooltip {
    background-color: rgba(240, 240, 240, 0.86);
    border: 1px solid rgba(0, 0, 0, 0.16);
    border-radius: 6px;
}

#qlTooltipLabel {
    color: #333333;
    font-size: 12px;
    background-color: transparent;
}

/* 文本标签 */
#weatherTempLabel,
#schoolNameLabel {
    color: #333333;
    font-size: 14px;
    background-color: transparent;
}

#weatherIconLabel {
    background-color: transparent;
}

#poetryLabel {
    color: #333333;
    font-size: 16px;
    background-color: transparent;
}

#schoolClassLabel {
    color: #333333;
    font-size: 16px;
    font-weight: bold;
    background-color: transparent;
}

/* 编辑按钮 */
#editButton {
    background-color: rgba(255, 255, 255, 0.6);
    color: #333333;
    border: none;
    border-radius: 6px;
    font-size: 14px;
}

#editButton:hover {
    background-color: rgba(255, 255, 255, 0.8);
}

/* 底部栏按钮 */
#backToDesktopBtn {
    background-color: rgba(0, 0, 0, 0.06);
    color: #333333;
    border: none;
    border-radius: 8px;
    font-size: 14px;
    padding: 8px 20px;
}

#backToDesktopBtn:hover {
    background-color: rgba(0, 0, 0, 0.12);
}

#bottomMenuBtn {
    background-color: transparent;
    border: none;
    border-radius: 8px;
    icon-size: 18px;
}

#bottomMenuBtn:hover {
    background-color: rgba(0, 0, 0, 0.08);
}

/* 页面管理按钮 */
#addPageBtn {
    background-color: rgba(0, 0, 0, 0.06);
    color: #333333;
    border: 1px dashed rgba(0, 0, 0, 0.25);
    border-radius: 8px;
    font-size: 13px;
    padding: 6px 14px;
}

#addPageBtn:hover {
    background-color: rgba(0, 0, 0, 0.12);
    border: 1px solid rgba(0, 0, 0, 0.3);
}

#delPageBtn,
#renamePageBtn {
    background-color: rgba(0, 0, 0, 0.06);
    color: #333333;
    border: 1px dashed rgba(0, 0, 0, 0.25);
    border-radius: 8px;
    font-size: 13px;
    padding: 6px 14px;
}

#delPageBtn:hover {
    background-color: rgba(255, 80, 80, 0.15);
    border: 1px solid rgba(255, 80, 80, 0.4);
}

#renamePageBtn:hover {
    background-color: rgba(0, 0, 0, 0.12);
    border: 1px solid rgba(0, 0, 0, 0.3);
}

/* 导航页 */
#navItemCell {
    background-color: rgba(0, 0, 0, 0.04);
    border: 1px solid rgba(0, 0, 0, 0.06);
    border-radius: 12px;
}

#navItemCell:hover {
    background-color: rgba(0, 0, 0, 0.08);
}

#navigationPage {
    background: transparent;
    border: none;
}

/* 编辑面板 */
#EditPanel {
    background-color: #F9F9F9;
    border: none;
}

#EditPanel QWidget {
    background-color: transparent;
    color: #000000;
}

#EditPanel SmoothScrollArea {
    background-color: #F9F9F9;
    border: none;
}

#EditPanel SmoothScrollArea QWidget {
    background-color: #F9F9F9;
}

#EditPanel QLabel#iconPreviewLabel {
    background-color: rgba(0, 0, 0, 0.05);
    border-radius: 8px;
}

/* 媒体组件 */
#mediaWidget {
    background-color: rgba(255, 255, 255, 0.65);
    border-radius: 16px;
    border: 1px solid rgba(0, 0, 0, 0.06);
}

MainWindow #mediaContainer,
#mediaProgressContainer,
#mediaLyricsWidget {
    background-color: transparent;
}

#mediaTitleLabel {
    color: #2C2C2E;
    font-weight: 600;
    font-size: 17px;
    background-color: transparent;
    letter-spacing: 0.4px;
}

#mediaArtistLabel {
    color: rgba(44, 44, 46, 0.6);
    font-size: 14px;
    background-color: transparent;
    letter-spacing: 0.3px;
}

#mediaTimeLabel,
#mediaDurationLabel {
    color: rgba(60, 60, 65, 0.45);
    font-size: 11px;
    font-weight: 500;
    background-color: transparent;
}

#mediaCoverLabel {
    background-color: transparent;
    border-radius: 10px;
}
